{
  "name": "space-mission-sim",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "play": "pnpm --filter @space-sim/web play",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo run clean",
    "wasm:build": "wasm-pack build crates/sim-wasm --target web --out-dir ../../apps/web/public/wasm",
    "cargo:check": "cargo check --workspace",
    "cargo:test": "cargo test --workspace",
    "db:generate": "pnpm --filter @space-sim/server db:generate",
    "db:push": "pnpm --filter @space-sim/server db:push",
    "test": "turbo run test",
    "test:e2e": "./apps/server/node_modules/.bin/tsx --test \"tests/e2e/**/*.test.ts\""
  },
  "devDependencies": {
    "prettier": "^3.5.2",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
