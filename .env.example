# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/space_mission_sim?schema=public"

# Redis Cache & Pub/Sub
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=4000
NODE_ENV=development
# HMAC secret for guest JWTs (min 16 chars). Required when NODE_ENV=production.
JWT_SECRET="change-me-to-a-long-random-string"
# Optional tuning (defaults shown)
# JWT_TTL_SECONDS=86400
# SNAPSHOT_DEBOUNCE_MS=2000
# ROOM_IDLE_TTL_MS=60000
# WS_MAX_PAYLOAD_BYTES=1048576

# Web Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000/sync"
